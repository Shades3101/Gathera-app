# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/gathera

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-use-at-least-32-characters
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# LiveKit Configuration
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Server Configuration
PORT=3001
FRONTEND_URL=http://localhost:3000

# Optional: Redis (required for horizontal scaling with multiple server instances)
# REDIS_URL=redis://localhost:6379
